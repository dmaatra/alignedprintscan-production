{
  "rewrites": [
    {
      "source": "/card",
      "destination": "/card.html"
    },
    {
      "source": "/doneisha",
      "destination": "/doneisha.html"
    },
    {
      "source": "/professionals/:slug",
      "destination": "/operator-card.html?slug=:slug"
    },
    {
      "source": "/resources-sitemap.xml",
      "destination": "https://sfsdniavqldgbiretply.supabase.co/functions/v1/resource-public?command=sitemap"
    },
    {
      "source": "/team",
      "destination": "/team.html"
    },
    {
      "source": "/neighborhood",
      "destination": "/neighborhood.html"
    }
  ],
  "headers": [
    {
      "source": "/admin-dashboard.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/business.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/card",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/doneisha",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/professionals/:slug",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
